# ==========================================
# School Cloud Print - Environment Variables
# ==========================================

# Database URL (SQLite default or PostgreSQL)
DATABASE_URL="file:./dev.db"

# NextAuth Secret & URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-random-key-change-this-in-production"

# Google OAuth Credentials (Belajar.id)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Initial Superadmin TU Email (Bypasses initial whitelist check)
INITIAL_ADMIN_EMAIL="admin.tu@admin.smp.belajar.id"

# Secret Key to authenticate Local Print Agent WebSocket connection
AGENT_SECRET_KEY="school-agent-secret-token-xyz123"

# Default Daily Quota per Teacher (Sheets per day)
DEFAULT_DAILY_QUOTA=20
