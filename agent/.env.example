# URL Server Cloud SMAN 3 Buru
CLOUD_SERVER_URL="http://cetak.smanegeri3buru.my.id"

# Token rahasia otentikasi (harus sama dengan AGENT_SECRET_KEY di server)
AGENT_SECRET_KEY="school-agent-secret-token-xyz123"

# IP Address Printer Epson EcoTank L6460 di jaringan WiFi/LAN TU (jika pakai LAN)
PRINTER_IP="192.168.0.177"

# Nama Printer Epson yang terpasang di Windows (Control Panel -> Devices and Printers)
# Jika pakai kabel USB, namanya biasanya: "EPSON L6460 Series"
# Jika pakai WiFi/LAN, namanya bisa: "L6460 Series(Network)" atau "EPSON L6460 Series"
WINDOWS_PRINTER_NAME="EPSON L6460 Series"

# Interval pemantauan sensor tinta (milidetik)
TELEMETRY_INTERVAL_MS=10000
